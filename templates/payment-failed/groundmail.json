] { background-color: #7a9bff !important; border-color: #7a9bff !important; }\n      [data-ogsb] a.em-button-danger, [data-ogsb] .em-button-danger a, [data-ogsb] .em-button-danger td[bgcolor] { background-color: #f97066 !important; border-color: #f97066 !important; }\n      @media only screen and (max-width: 600px) {\n      .em-card-body > tbody > tr > td { padding: 32px 24px !important; }\n      .em-h1, .em-h1 > div { font-size: 22px !important; line-height: 30px !important; }\n      }\n    </style>\n  </head>\n  <body\n    class=\"em-page\"\n    dir=\"ltr\"\n    lang=\"en\"\n    style=\"background-color:#f4f4f5;margin:0;padding:0\">\n    <div\n      style=\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\"\n      data-skip-in-text=\"true\">\n      We couldn&#x27;t charge {{payment_method}}. Update it before\n      {{retry_date}} to keep your plan.\n      <div>\n         ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿\n      </div>\n    </div>\n    <table\n      border=\"0\"\n      width=\"100%\"\n      cellpadding=\"0\"\n      cellspacing=\"0\"\n      role=\"presentation\"\n      align=\"center\">\n      <tbody>\n        <tr>\n          <td\n            dir=\"ltr\"\n            lang=\"en\"\n            style=\"margin:0;padding:0;background-color:#f4f4f5;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Helvetica, Arial, sans-serif;-webkit-font-smoothing:antialiased\">\n            <table\n              align=\"center\"\n              width=\"100%\"\n              class=\"em-page\"\n              border=\"0\"\n              cellpadding=\"0\"\n              cellspacing=\"0\"\n              role=\"presentation\"\n              style=\"max-width:560px;width:100%;margin:0 auto\">\n              <tbody>\n                <tr style=\"width:100%\">\n                  <td style=\"padding:40px 16px\">\n                    <table\n                      align=\"center\"\n                      width=\"100%\"\n                      border=\"0\"\n                      cellpadding=\"0\"\n                      cellspacing=\"0\"\n                      role=\"presentation\">\n                      <tbody>\n                        <tr>\n                          <td style=\"padding:0 8px 24px\">\n                            <a\n                              href=\"https://example.com\"\n                              style=\"color:#067df7;text-decoration-line:none;text-decoration:none\"\n                              target=\"_blank\"\n                              ><p\n                                class=\"em-wordmark\"\n                                style=\"font-size:18px;line-height:28px;margin:0;font-weight:700;letter-spacing:-0.2px;color:#18181b;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">\n                                Acme\n                              </p></a\n                            >\n                          </td>\n                        </tr>\n                      </tbody>\n                    </table>\n                    <table\n                      align=\"center\"\n                      width=\"100%\"\n                      border=\"0\"\n                      cellpadding=\"0\"\n                      cellspacing=\"0\"\n                      role=\"presentation\"\n                      class=\"em-card\"\n                      style=\"background-color:#ffffff;border:1px solid #e4e4e7;border-radius:12px\">\n                      <tbody>\n                        <tr>\n                          <td>\n                            <table\n                              align=\"center\"\n                              width=\"100%\"\n                              border=\"0\"\n                              cellpadding=\"0\"\n                              cellspacing=\"0\"\n                              role=\"presentation\"\n                              class=\"em-card-body\">\n                              <tbody>\n                                <tr>\n                                  <td style=\"padding:40px 40px\">\n                                    <h1\n                                      class=\"em-text em-h1\"\n                                      style=\"margin:0 0 16px;font-size:24px;line-height:32px;font-weight:650;letter-spacing:-0.3px;color:#18181b\">\n                                      Your payment didn&#x27;t go through\n                                    </h1>\n                                    <p\n                                      class=\"em-text\"\n                                      style=\"font-size:15px;line-height:24px;margin:0 0 16px;color:#18181b;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0\">\n                                      Hi {{name}}, we couldn&#x27;t charge your\n                                      {{payment_method}} for your {{plan_name}}\n                                      plan. This usually happens when a card\n                                      expires or the bank declines the charge.\n                                    </p>\n                                    <table\n                                      align=\"center\"\n                                      width=\"100%\"\n                                      border=\"0\"\n                                      cellpadding=\"0\"\n                                      cellspacing=\"0\"\n                                      role=\"presentation\"\n                                      style=\"margin:0 0 24px\">\n                                      <tbody>\n                                        <tr>\n                                          <td>\n                                            <table\n                                              align=\"center\"\n                                              width=\"100%\"\n                                              border=\"0\"\n                                              cellpadding=\"0\"\n                                              cellspacing=\"0\"\n                                              role=\"presentation\"\n                                              class=\"em-border\">\n                                              <tbody style=\"width:100%\">\n                                                <tr style=\"width:100%\">\n                                                  <td\n                                                    class=\"em-muted\"\n                                                    data-id=\"__react-email-column\"\n                                                    style=\"padding:10px 0;font-size:14px;line-height:20px;vertical-align:top;color:#52525b;width:45%\">\n                                                    Plan\n                                                  </td>\n                                                  <td\n                                                    class=\"em-text\"\n                                                    data-id=\"__react-email-column\"\n                                                    style=\"padding:10px 0;font-size:14px;line-height:20px;vertical-align:top;color:#18181b;text-align:right\">\n                                                    {{plan_name}}\n                                                  </td>\n                                                </tr>\n                                              </tbody>\n                                            </table>\n                                            <table\n                                              align=\"center\"\n                                              width=\"100%\"\n                                              border=\"0\"\n                                              cellpadding=\"0\"\n                                              cellspacing=\"0\"\n                                              role=\"presentation\"\n                                              class=\"em-border\"\n                                              style=\"border-top:1px solid #e4e4e7\">\n                                              <tbody style=\"width:100%\">\n                                                <tr style=\"width:100%\">\n                                                  <td\n                                                    class=\"em-muted\"\n                                                    data-id=\"__react-email-column\"\n                                                    style=\"padding:10px 0;font-size:14px;line-height:20px;vertical-align:top;color:#52525b;width:45%\">\n                                                    Amount due\n                                                  </td>\n                                                  <td\n                                                    class=\"em-text\"\n                                                    data-id=\"__react-email-column\"\n                                                    style=\"padding:10px 0;font-size:14px;line-height:20px;vertical-align:top;color:#18181b;text-align:right\">\n                                                    {{amount}}\n                                                  </td>\n                                                </tr>\n                                              </tbody>\n                                            </table>\n                                            <table\n                                              align=\"center\"\n                                              width=\"100%\"\n                                              border=\"0\"\n                                              cellpadding=\"0\"\n                                              cellspacing=\"0\"\n                                              role=\"presentation\"\n                                              class=\"em-border\"\n                                              style=\"border-top:1px solid #e4e4e7\">\n                                              <tbody style=\"width:100%\">\n                                                <tr style=\"width:100%\">\n                                                  <td\n                                                    class=\"em-muted\"\n                                                    data-id=\"__react-email-column\"\n                                                    style=\"padding:10px 0;font-size:14px;line-height:20px;vertical-align:top;color:#52525b;width:45%\">\n                                                    Next attempt\n                                                  </td>\n                                                  <td\n                                                    class=\"em-text\"\n                                                    data-id=\"__react-email-column\"\n                                                    style=\"padding:10px 0;font-size:14px;line-height:20px;vertical-align:top;color:#18181b;text-align:right\">\n                                                    {{retry_date}}\n                                                  </td>\n                                                </tr>\n                                              </tbody>\n                                            </table>\n                                          </td>\n                                        </tr>\n                                      </tbody>\n                                    </table>\n                                    <p\n                                      class=\"em-text\"\n                                      style=\"font-size:15px;line-height:24px;margin:0 0 16px;color:#18181b;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0\">\n                                      Update your payment method before\n                                      {{retry_date}} to keep your account\n                                      active.\n                                    </p>\n                                    <table\n                                      align=\"center\"\n                                      width=\"100%\"\n                                      border=\"0\"\n                                      cellpadding=\"0\"\n                                      cellspacing=\"0\"\n                                      role=\"presentation\"\n                                      style=\"margin:8px 0 24px\">\n                                      <tbody>\n                                        <tr>\n                                          <td>\n                                            <a\n                                              class=\"em-button\"\n                                              href=\"{{update_url}}\"\n                                              style=\"line-height:20px;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#2f5bd3;color:#ffffff;font-size:15px;font-weight:600;border-radius:8px;padding:12px 22px;padding-top:12px;padding-right:22px;padding-bottom:12px;padding-left:22px\"\n                                              target=\"_blank\"\n                                              ><span\n                                                ><!--[if mso]><i style=\"mso-font-width:366.66666666666663%;mso-text-raise:18px\" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span\n                                              ><span\n                                                style=\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px\"\n                                                >Update payment method</span\n                                              ><span\n                                                ><!--[if mso]><i style=\"mso-font-width:366.66666666666663%\" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span\n                                              ></a\n                                            >\n                                          </td>\n                                        </tr>\n                                      </tbody>\n                                    </table>\n                                    <p\n                                      class=\"em-muted\"\n                                      style=\"font-size:13px;line-height:20px;margin:0;color:#52525b;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">\n                                      Already updated your details? You can\n                                      ignore this email.\n                                    </p>\n                                  </td>\n                                </tr>\n                              </tbody>\n                            </table>\n                          </td>\n                        </tr>\n                      </tbody>\n                    </table>\n                    <table\n                      align=\"center\"\n                      width=\"100%\"\n                      border=\"0\"\n                      cellpadding=\"0\"\n                      cellspacing=\"0\"\n                      role=\"presentation\"\n                      style=\"text-align:center\">\n                      <tbody>\n                        <tr>\n                          <td style=\"padding:24px 8px 0\">\n                            <p\n                              class=\"em-muted\"\n                              style=\"font-size:12px;line-height:18px;margin:0 0 6px;color:#52525b;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0\">\n                              You&#x27;re receiving this because a payment for\n                              your subscription failed.\n                            </p>\n                            <p\n                              class=\"em-muted\"\n                              style=\"font-size:12px;line-height:18px;margin:0 0 6px;color:#52525b;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0\">\n                              Acme Inc. · 100 Market Street · San Francisco, CA\n                              94105\n                            </p>\n                          </td>\n                        </tr>\n                      </tbody>\n                    </table>\n                  </td>\n                </tr>\n              </tbody>\n            </table>\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </body>\n</html>\n",
  "text": "Your payment didn't go through\n\nHi {{name}}, we couldn't charge your {{payment_method}} for your {{plan_name}} plan. This usually happens when a card expires or the bank declines the charge.\n\nPlan:         {{plan_name}}\nAmount due:   {{amount}}\nNext attempt: {{retry_date}}\n\nUpdate your payment method before {{retry_date}} to keep your account active:\n\n{{update_url}}\n\nAlready updated your details? You can ignore this email.\n\n--\n\nAcme\nAcme Inc. · 100 Market Street · San Francisco, CA 94105\n",
