  "html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html dir=\"ltr\" lang=\"en\">\n  <head>\n    <meta content=\"text/html; charset=UTF-8\" http-equiv=\"Content-Type\" />\n    <meta name=\"x-apple-disable-message-reformatting\" />\n    <meta name=\"color-scheme\" content=\"light dark\" />\n    <meta name=\"supported-color-schemes\" content=\"light dark\" />\n    <title>\n      We couldn&#x27;t charge {{payment_method}}. Update it before\n      {{retry_date}} to keep your plan.\n    </title>\n    <style>\n      :root { color-scheme: light dark; supported-color-schemes: light dark; }\n      .em-logo-dark { display: none; }\n      @media (prefers-color-scheme: dark) {\n      .em-page, .em-page > table > tbody > tr > td { background-color: #0e0e10 !important; }\n      .em-card { background-color: #18181b !important; border-color: #2e2e33 !important; }\n      .em-text, .em-text > div { color: #f4f4f5 !important; }\n      .em-muted, .em-muted > div, .em-muted a { color: #a1a1aa !important; }\n      .em-link, .em-text a { color: #7a9bff !important; }\n      .em-wordmark, .em-wordmark > div, .em-wordmark a { color: #f4f4f5 !important; }\n      .em-subtle { background-color: #232327 !important; border-color: #2e2e33 !important; }\n      .em-border { border-color: #2e2e33 !important; }\n      .em-strong-border { border-color: #f4f4f5 !important; }\n      .em-rule, .em-rule p { border-top-color: #2e2e33 !important; }\n      .em-track { background-color: #232327 !important; }\n      .em-fill { background-color: #7a9bff !important; }\n      a.em-button, .em-button a, .em-button td[bgcolor] { background-color: #7a9bff !important; color: #0b0d14 !important; border-color: #7a9bff !important; }\n      a.em-button-danger, .em-button-danger a, .em-button-danger td[bgcolor] { background-color: #f97066 !important; color: #0b0d14 !important; border-color: #f97066 !important; }\n      .em-logo-light { d