<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>Reset your password</mj-title>
    <mj-preview>Use this link to choose a new password. It expires in {{expires_in}}.</mj-preview>
    <!-- theme:start -->
    <!-- Generated from theme.ts by `npm run build`. Edit theme.ts, not this block. -->
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-body background-color="#f4f4f5" width="560px" />
      <mj-wrapper padding="40px 16px" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-text padding="0 0 16px" font-size="15px" line-height="24px" color="#18181b" css-class="em-text" />
      <mj-button align="left" background-color="#2f5bd3" color="#ffffff" font-size="15px" font-weight="600" line-height="20px" border-radius="8px" inner-padding="12px 22px" padding="8px 0 24px" css-class="em-button" />
      <mj-divider border-width="1px" border-color="#e4e4e7" padding="12px 0 28px" css-class="em-rule" />
      <mj-table padding="0 0 24px" font-size="14px" line-height="20px" color="#18181b" />
      <mj-class name="card" background-color="#ffffff" border="1px solid #e4e4e7" border-radius="12px" padding="40px" css-class="em-card" />
      <mj-class name="h1" font-size="24px" line-height="32px" font-weight="650" letter-spacing="-0.3px" css-class="em-text em-h1" />
      <mj-class name="small" font-size="13px" line-height="20px" color="#52525b" padding="0 0 12px" css-class="em-muted" />
      <mj-class name="danger" background-color="#b42318" css-class="em-button-danger" />
      <mj-class name="footer" font-size="12px" line-height="18px" color="#52525b" align="center" padding="0 0 6px" css-class="em-muted" />
    </mj-attributes>
    <mj-style inline="inline">
      .em-label { padding: 10px 0; color: #52525b; width: 45%; vertical-align: top; }
      .em-value { padding: 10px 0; color: #18181b; text-align: right; vertical-align: top; }
      .em-row-border { border-top: 1px solid #e4e4e7; }
      .em-total { padding: 12px 0 10px; color: #18181b; font-weight: 650; border-top: 2px solid #18181b; vertical-align: top; }
      .em-total-value { padding: 12px 0 10px; color: #18181b; font-weight: 650; border-top: 2px solid #18181b; text-align: right; vertical-align: top; }
      .em-codebox { margin: 8px 0 8px; padding: 18px 12px; background-color: #f4f4f5; border: 1px solid #e4e4e7; border-radius: 8px; text-align: center; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace; font-size: 32px; line-height: 40px; font-weight: 700; letter-spacing: 8px; color: #18181b; }
      .em-callout { padding: 14px 16px; background-color: #f4f4f5; border: 1px solid #e4e4e7; border-radius: 8px; font-size: 14px; line-height: 22px; color: #18181b; }
      .em-track { height: 8px; font-size: 1px; line-height: 8px; border-radius: 999px; background-color: #f4f4f5; }
      .em-fill { height: 8px; font-size: 1px; line-height: 8px; border-radius: 999px; background-color: #2f5bd3; }
      .em-link { color: #2f5bd3; text-decoration: underline; }
      .em-step { color: #52525b; }
    </mj-style>
    <mj-style>
      body { -webkit-font-smoothing: antialiased; }
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      .em-logo-dark { display: none; }
      @media (prefers-color-scheme: dark) {
      body, .em-page { background-color: #0e0e10 !important; }
      .em-card, .em-card > table, .em-card > table > tbody > tr > td { background-color: #18181b !important; border-color: #2e2e33 !important; }
      .em-text, .em-text > div { color: #f4f4f5 !important; }
      .em-muted, .em-muted > div, .em-muted a { color: #a1a1aa !important; }
      .em-link, .em-text a { color: #7a9bff !important; }
      .em-wordmark, .em-wordmark > div, .em-wordmark a { color: #f4f4f5 !important; }
      .em-subtle { background-color: #232327 !important; border-color: #2e2e33 !important; }
      .em-border { border-color: #2e2e33 !important; }
      .em-strong-border { border-color: #f4f4f5 !important; }
      .em-rule, .em-rule p { border-top-color: #2e2e33 !important; }
      .em-track { background-color: #232327 !important; }
      .em-fill { background-color: #7a9bff !important; }
      a.em-button, .em-button a, .em-button td[bgcolor] { background-color: #7a9bff !important; color: #0b0d14 !important; border-color: #7a9bff !important; }
      a.em-button-danger, .em-button-danger a, .em-button-danger td[bgcolor] { background-color: #f97066 !important; color: #0b0d14 !important; border-color: #f97066 !important; }
      .em-logo-light { display: none !important; }
      .em-logo-dark { display: block !important; }
      }
      [data-ogsc] .em-card, [data-ogsc] .em-card > table, [data-ogsc] .em-card > table > tbody > tr > td { border-color: #2e2e33 !important; }
      [data-ogsc] .em-text, [data-ogsc] .em-text > div { color: #f4f4f5 !important; }
      [data-ogsc] .em-muted, [data-ogsc] .em-muted > div, [data-ogsc] .em-muted a { color: #a1a1aa !important; }
      [data-ogsc] .em-link, [data-ogsc] .em-text a { color: #7a9bff !important; }
      [data-ogsc] .em-wordmark, [data-ogsc] .em-wordmark > div, [data-ogsc] .em-wordmark a { color: #f4f4f5 !important; }
      [data-ogsc] .em-subtle { border-color: #2e2e33 !important; }
      [data-ogsc] .em-border { border-color: #2e2e33 !important; }
      [data-ogsc] .em-strong-border { border-color: #f4f4f5 !important; }
      [data-ogsc] .em-rule, [data-ogsc] .em-rule p { border-top-color: #2e2e33 !important; }
      [data-ogsc] a.em-button, [data-ogsc] .em-button a, [data-ogsc] .em-button td[bgcolor] { color: #0b0d14 !important; border-color: #7a9bff !important; }
      [data-ogsc] a.em-button-danger, [data-ogsc] .em-button-danger a, [data-ogsc] .em-button-danger td[bgcolor] { color: #0b0d14 !important; border-color: #f97066 !important; }
      [data-ogsb] body, [data-ogsb] .em-page { background-color: #0e0e10 !important; }
      [data-ogsb] .em-card, [data-ogsb] .em-card > table, [data-ogsb] .em-card > table > tbody > tr > td { background-color: #18181b !important; border-color: #2e2e33 !important; }
      [data-ogsb] .em-subtle { background-color: #232327 !important; border-color: #2e2e33 !important; }
      [data-ogsb] .em-border { border-color: #2e2e33 !important; }
      [data-ogsb] .em-strong-border { border-color: #f4f4f5 !important; }
      [data-ogsb] .em-rule, [data-ogsb] .em-rule p { border-top-color: #2e2e33 !important; }
      [data-ogsb] .em-track { background-color: #232327 !important; }
      [data-ogsb] .em-fill { background-color: #7a9bff !important; }
      [data-ogsb] a.em-button, [data-ogsb] .em-button a, [data-ogsb] .em-button td[bgcolor] { background-color: #7a9bff !important; border-color: #7a9bff !important; }
      [data-ogsb] a.em-button-danger, [data-ogsb] .em-button-danger a, [data-ogsb] .em-button-danger td[bgcolor] { background-color: #f97066 !important; border-color: #f97066 !important; }
      @media only screen and (max-width: 600px) {
      .em-card > table > tbody > tr > td { padding: 32px 24px !important; }
      .em-h1, .em-h1 > div { font-size: 22px !important; line-height: 30px !important; }
      }
    </mj-style>
    <!-- theme:end -->
  </mj-head>
  <mj-body>
    <!-- header:start -->
    <!-- Generated from theme.ts by `npm run build`. Edit theme.ts, not this block. -->
    <mj-wrapper css-class="em-page">
      <mj-section padding="0 8px 24px">
        <mj-column>
          <mj-text padding="0" font-size="18px" line-height="28px" font-weight="700" letter-spacing="-0.2px" css-class="em-wordmark"><a href="https://example.com" style="color:#18181b;text-decoration:none;">Acme</a></mj-text>
        </mj-column>
      </mj-section>
      <!-- header:end -->
      <mj-section mj-class="card">
        <mj-column>
          <mj-text mj-class="h1">Reset your password</mj-text>
          <mj-text>Hi {{name}},</mj-text>
          <mj-text>Someone asked to reset the password for your account. Choose a new one with the button below.</mj-text>
          <mj-button href="{{reset_url}}">Choose a new password</mj-button>
          <mj-text mj-class="small">This link expires in {{expires_in}} and can only be used once. If you didn't ask for a reset, you can ignore this email. Your password won't change.</mj-text>
          <mj-divider />
          <mj-text mj-class="small" padding="0">If the button doesn't work, paste this link into your browser:<br /><a class="em-link" href="{{reset_url}}" style="word-break:break-all;">{{reset_url}}</a></mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="24px 8px 0">
        <mj-column>
          <mj-text mj-class="footer">You're receiving this because a password reset was requested for your account.</mj-text>
        </mj-column>
      </mj-section>
    <!-- footer:start -->
    <!-- Generated from theme.ts by `npm run build`. Edit theme.ts, not this block. -->
      <mj-section padding="0 8px">
        <mj-column>
          <mj-text mj-class="footer">Acme Inc. · 100 Market Street · San Francisco, CA 94105</mj-text>
        </mj-column>
      </mj-section>
      </mj-wrapper>
    <!-- footer:end -->
  </mj-body>
</mjml>
