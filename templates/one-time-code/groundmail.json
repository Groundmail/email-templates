  "html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html dir=\"ltr\" lang=\"en\">\n  <head>\n    <meta content=\"text/html; charset=UTF-8\" http-equiv=\"Content-Type\" />\n    <meta name=\"x-apple-disable-message-reformatting\" />\n    <meta name=\"color-scheme\" content=\"light dark\" />\n    <meta name=\"supported-color-schemes\" content=\"light dark\" />\n    <title>\n      Your verification code is {{code}}. It expires in {{expires_in}}.\n    </title>\n    <style>\n      :root { color-scheme: light dark; supported-color-schemes: light dark; }\n      .em-logo-dark { display: none; }\n      @media (prefers-color-scheme: dark) {\n      .em-page, .em-page > table > tbody > tr > td { background-color: #0e0e10 !important; }\n      .em-card { background-color: #18181b !important; border-color: #2e2e33 !important; }\n      .em-text, .em-text > div { color: #f4f4f5 !important; }\n      .em-muted, .em-muted > div, .em-muted a { color: #a1a1aa !important; }\n      .em-link, .em-text a { color: #7a9bff !important; }\n      .em-wordmark, .em-wordmark > div, .em-wordmark a { color: #f4f4f5 !important; }\n      .em-subtle { background-color: #232327 !important; border-color: #2e2e33 !important; }\n      .em-border { border-color: #2e2e33 !important; }\n      .em-strong-border { border-color: #f4f4f5 !important; }\n      .em-rule, .em-rule p { border-top-color: #2e2e33 !important; }\n      .em-track { background-color: #232327 !important; }\n      .em-fill { background-color: #7a9bff !important; }\n      a.em-button, .em-button a, .em-button td[bgcolor] { background-color: #7a9bff !important; color: #0b0d14 !important; border-color: #7a9bff !important; }\n      a.em-button-danger, .em-button-danger a, .em-button-danger td[bgcolor] { background-color: #f97066 !important; color: #0b0d14 !important; border-color: #f97066 !important; }\n      .em-logo-light { display: none !important; }\n      .em-logo-dark { display: block !important; }\n      }\n      [data-ogsc] .em-card { border-color: #2e2e33 !important; }\n      [data-ogsc] .em-text, [data-ogsc] .em-text > div { color: #f4f4f5 !important; }\n      [data-ogsc] .em-muted, [data-ogsc] .em-muted > div, [data-ogsc] .em-muted a { color: #a1a1aa !important; }\n      [data-ogsc] .em-link, [data-ogsc] .em-text a { color: #7a9bff !important; }\n      [data-ogsc] .em-wordmark, [data-ogsc] .em-wordmark > div, [data-ogsc] .em-wordmark a { color: #f4f4f5 !important; }\n      [data-ogsc] .em-subtle { border-color: #2e2e33 !important; }\n      [data-ogsc] .em-border { border-color: #2e2e33 !important; }\n      [data-ogsc] .em-strong-border { border-color: #f4f4f5 !important; }\n      [data-ogsc] .em-rule, [data-ogsc] .em-rule p { border-top-color: #2e2e33 !important; }\n      [data-ogsc] a.em-button, [data-ogsc] .em-button a, [data-ogsc] .em-button td[bgcolor] { color: #0b0d14 !important; border-color: #7a9bff !important; }\n      [data-ogsc] a.em-button-danger, [data-ogsc] .em-button-danger a, [data-ogsc] .em-button-danger td[bgcolor] { color: #0b0d14 !important; border-color: #f97066 !important; }\n      [data-ogsb] .em-page, [data-ogsb] .em-page > table > tbody > tr > td { background-color: #0e0e10 !important; }\n      [data-ogsb] .em-card { background-color: #18181b !important; border-color: #2e2e33 !important; }\n      [data-ogsb] .em-subtle { background-color: #232327 !important; border-color: #2e2e33 !important; }\n      [data-ogsb] .em-border { border-color: #2e2e33 !important; }\n      [data-ogsb] .em-strong-border { border-color: #f4f4f5 !important; }\n      [data-ogsb] .em-rule, [data-ogsb] .em-rule p { border-top-color: #2e2e33 !important; }\n      [data-ogsb] .em-track { background-color: #232327 !important; }\n      [data-ogsb] .em-fill { background-color: #7a9bff !important; }\n      [data-ogsb] a.em-button, [data-ogsb] .em-button a, [data-ogsb] .em-button td[bgcolor] { background-color: #7a9bff !important; border-color: #7a9bff !important; }\n      [data-ogsb] a.em-button-danger, [data-ogsb] .em-button-danger a, [data-ogsb] .em-button-danger td[bgcolor] { background-color: #f97066 !important; border-color: #f97066 !important; }\n      @media only screen and (max-width: 600px) {\n      .em-card-body > tbody > tr > td { padding: 32px 24px !important; }\n      .em-h1, .em-h1 > div { font-size: 22px !important; line-height: 30px !important; }\n      }\n    </style>\n  </head>\n  <body\n    class=\"em-page\"\n    dir=\"ltr\"\n    lang=\"en\"\n    style=\"background-color:#f4f4f5;margin:0;padding:0\">\n    <div\n      style=\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\"\n      data-skip-in-text=\"true\">\n      Your verification code is {{code}}. It expires in {{expires_in}}.\n      <div>\n         ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿\n      </div>\n    </div>\n    <table\n      border=\"0\"\n      width=\"100%\"\n      cellpadding=\"0\"\n      cellspacing=\"0\"\n      role=\"presentation\"\n      align=\"center\">\n      <tbody>\n        <tr>\n          <td\n            dir=\"ltr\"\n            lang=\"en\"\n            style=\"margin:0;padding:0;background-color:#f4f4f5;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Helvetica, Arial, sans-serif;-webkit-font-smoothing:antialiased\">\n            <table\n              align=\"center\"\n              width=\"100%\"\n              class=\"em-page\"\n              border=\"0\"\n              cellpadding=\"0\"\n              cellspacing=\"0\"\n              role=\"presentation\"\n              style=\"max-width:560px;width:100%;margin:0 auto\">\n              <tbody>\n                <tr style=\"width:100%\">\n                  <td style=\"padding:40px 16px\">\n                    <table\n                      align=\"center\"\n                      width=\"100%\"\n                      border=\"0\"\n                      cellpadding=\"0\"\n                      cellspacing=\"0\"\n                      role=\"presentation\">\n                      <tbody>\n                        <tr>\n                          <td style=\"padding:0 8px 24px\">\n                            <a\n                              href=\"https://example.com\"\n                              style=\"color:#067df7;text-decoration-line:none;text-decoration:none\"\n                              target=\"_blank\"\n                              ><p\n                                class=\"em-wordmark\"\n                                style=\"font-size:18px;line-height:28px;margin:0;font-weight:700;letter-spacing:-0.2px;color:#18181b;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">\n                                Acme\n                              </p></a\n                            >\n                          </td>\n                        </tr>\n                      </tbody>\n                    </table>\n                    <table\n                      align=\"center\"\n                      width=\"100%\"\n                      border=\"0\"\n                      cellpadding=\"0\"\n                      cellspacing=\"0\"\n                      role=\"presentation\"\n                      class=\"em-card\"\n                      style=\"background-color:#ffffff;border:1px solid #e4e4e7;border-radius:12px\">\n                      <tbody>\n                        <tr>\n                          <td>\n                            <table\n                              align=\"center\"\n                              width=\"100%\"\n                              border=\"0\"\n                              cellpadding=\"0\"\n                              cellspacing=\"0\"\n                              role=\"presentation\"\n                              class=\"em-card-body\">\n                              <tbody>\n                                <tr>\n                                  <td style=\"padding:40px 40px\">\n                                    <h1\n                                      class=\"em-text em-h1\"\n                                      style=\"margin:0 0 16px;font-size:24px;line-height:32px;font-weight:650;letter-spacing:-0.3px;color:#18181b\">\n                                      Your verification code\n                                    </h1>\n                                    <p\n                                      class=\"em-text\"\n                                      style=\"font-size:15px;line-height:24px;margin:0 0 16px;color:#18181b;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0\">\n                                      Enter this code to continue:\n                                    </p>\n                                    <p\n                                      class=\"em-text em-subtle\"\n                                      style=\"font-size:32px;line-height:40px;margin:8px 0 24px;padding:18px 12px;background-color:#f4f4f5;border:1px solid #e4e4e7;border-radius:8px;text-align:center;font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, &#x27;Liberation Mono&#x27;, monospace;font-weight:700;letter-spacing:8px;color:#18181b;margin-top:8px;margin-right:0;margin-bottom:24px;margin-left:0\">\n                                      {{code}}\n                                    </p>\n                                    <p\n                                      class=\"em-muted\"\n                                      style=\"font-size:13px;line-height:20px;margin:0 0 12px;color:#52525b;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\">\n                                      The code expires in {{expires_in}}. We\n                                      will never ask you for this code by phone,\n                                      chat or email, so don&#x27;t share it with\n                                      anyone.\n                                    </p>\n                                    <p\n                                      class=\"em-muted\"\n                                      style=\"font-size:13px;line-height:20px;margin:0;color:#52525b;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">\n                                      Didn&#x27;t request a code? Someone may\n                                      know your password. Change it to keep your\n                                      account safe.\n                                    </p>\n                                  </td>\n                                </tr>\n                              </tbody>\n                            </table>\n                          </td>\n                        </tr>\n                      </tbody>\n                    </table>\n                    <table\n                      align=\"center\"\n                      width=\"100%\"\n                      border=\"0\"\n                      cellpadding=\"0\"\n                      cellspacing=\"0\"\n                      role=\"presentation\"\n                      style=\"text-align:center\">\n                      <tbody>\n                        <tr>\n                          <td style=\"padding:24px 8px 0\">\n                            <p\n                              class=\"em-muted\"\n                              style=\"font-size:12px;line-height:18px;margin:0 0 6px;color:#52525b;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0\">\n                              You&#x27;re receiving this because a verification\n                              code was requested for your account.\n                            </p>\n                            <p\n                              class=\"em-muted\"\n                              style=\"font-size:12px;line-height:18px;margin:0 0 6px;color:#52525b;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0\">\n                              Acme Inc. · 100 Market Street · San Francisco, CA\n                              94105\n                            </p>\n                          </td>\n                        </tr>\n                      </tbody>\n                    </table>\n                  </td>\n                </tr>\n              </tbody>\n            </table>\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </body>\n</html>\n",
  "text": "Your verification code\n\nEnter this code to continue: {{code}}\n\nThe code expires in {{expires_in}}. We will never ask you for this code by phone, chat or email, so don't share it with anyone.\n\nDidn't request a code? Someone may know your password. Change it to keep your account safe.\n\n--\n\nAcme\nAcme Inc. · 100 Market Street · San Francisco, CA 94105\n",
  "variables": [
    "code",
    "expires_in"
